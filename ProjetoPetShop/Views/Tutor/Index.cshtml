@model IEnumerable<ProjetoPetShop.Models.Tutor>

@{
    ViewData["Title"] = "Index";
}
<br />
<h2>Lista de tutores </h2>

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">Cadastrar</a>
</p>
<div class="table-responsive">
    <table class="table table-bordered">

        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(model => model.First().id)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.First().nome)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.First().telefone)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.First().email)</th>
                <th scope="col">Ação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Tutor tutor in Model)
            {
                <tr>
                    <th scope="row">@tutor.id</th>
                    <td>@tutor.nome)</td>
                    <td>@tutor.telefone)</td>
                    <td>@tutor.email)</td>
                    <td>
                        <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@tutor.id">Editar</a>
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@tutor.id">Detalhes</a>
                        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@tutor.id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>